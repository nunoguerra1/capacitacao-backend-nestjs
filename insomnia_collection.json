{
    "info": {
        "name": "Blog API - Capacitação",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Criar Usuário",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Administrador\",\n  \"email\": \"admin@blog.com\",\n  \"password\": \"senha123\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3000/users",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "users"
                    ]
                }
            }
        },
        {
            "name": "2. Login",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"admin@blog.com\",\n  \"password\": \"senha123\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3000/auth/login",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "3. Criar Post",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer COLOQUE_SEU_TOKEN_AQUI"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Meu Primeiro Post do Blog\",\n  \"content\": \"Este é o conteúdo do meu post que tem mais de 50 caracteres para passar na validação rígida do NestJS!\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3000/posts",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "posts"
                    ]
                }
            }
        },
        {
            "name": "4. Listar Posts (Paginado)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:3000/posts?page=1&limit=10",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "posts"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1"
                        },
                        {
                            "key": "limit",
                            "value": "10"
                        }
                    ]
                }
            }
        },
        {
            "name": "5. Atualizar Post",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer COLOQUE_SEU_TOKEN_AQUI"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Título Atualizado do Meu Post\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3000/posts/COLOQUE_O_ID_DO_POST_AQUI",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "posts",
                        "COLOQUE_O_ID_DO_POST_AQUI"
                    ]
                }
            }
        },
        {
            "name": "6. Deletar Post",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer COLOQUE_SEU_TOKEN_AQUI"
                    }
                ],
                "url": {
                    "raw": "http://localhost:3000/posts/COLOQUE_O_ID_DO_POST_AQUI",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "posts",
                        "COLOQUE_O_ID_DO_POST_AQUI"
                    ]
                }
            }
        }
    ]
}